{
  "openapi": "3.1.0",
  "info": {
    "title": "NJV SG 需求情报工作台 (backend)",
    "version": "0.1.0",
    "description": "Minimal conforming backend for the NJV SG workbench (Substrait contract). The workbench is a static frontend; this backend only satisfies the platform's hard requirements (port 8000, GET /health, /api under ingress)."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/info": {
      "get": {
        "summary": "App info",
        "operationId": "info",
        "responses": {
          "200": {
            "description": "Static app metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "app": { "type": "string" },
                    "mode": { "type": "string" },
                    "data": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": { "schemas": {} }
}
