# Frontend image for Substrait: copy the prebuilt static workbench into nginx and
# serve it on port 80. Built from the REPO ROOT, so COPY paths are repo-relative.
#
# The workbench is plain static HTML/JS/CSS (no build step), so there is no npm
# stage — we copy frontend/ straight into the nginx document root. The ingress
# routes /api to the backend, so nginx only ever serves the static site.
FROM nginx:1.27-alpine
COPY frontend/ /usr/share/nginx/html/
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
